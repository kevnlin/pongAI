# Copy to .env (git-ignored) and fill in. Real environment variables take precedence.

# OpenAI (coach feedback + scripts/eval_vlm.py)
OPENAI_API_KEY=
PONGAI_LLM_MODEL=gpt-4o-mini

# Free alternative: local OpenAI-compatible VLM server (vLLM / Ollama)
# PONGAI_LLM_BASE_URL=http://localhost:8001/v1
# PONGAI_LLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# PONGAI_LLM_API_KEY=none
